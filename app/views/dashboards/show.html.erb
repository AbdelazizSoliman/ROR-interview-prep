<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
  <section>
    <p class="text-sm font-semibold uppercase tracking-widest text-red-700">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Ruby &amp; Rails Interview Prep</h1>
    <p class="mt-3 text-slate-600">Welcome back, <%= current_user.email %>.</p>
  </section>

  <section class="mt-10 max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="core-mid-title">
    <p class="text-sm font-semibold uppercase tracking-widest text-red-700">Core practice</p>
    <h2 id="core-mid-title" class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Core Mid-Level Practice</h2>
    <p class="mt-3 text-slate-600">Up to 10 core Ruby, Rails, database, testing, and architecture questions answered from memory.</p>

    <div class="mt-6">
      <% if @active_session %>
        <%= link_to "Resume Practice", study_session_path(@active_session), class: "inline-flex rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
      <% else %>
        <%= button_to "Start Core Mid-Level Practice", study_sessions_path, method: :post, class: "rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
      <% end %>
    </div>
  </section>

  <section class="mt-8 max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="daily-review-title">
    <p class="text-sm font-semibold uppercase tracking-widest text-red-700">Review queue</p>
    <h2 id="daily-review-title" class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Daily Review</h2>
    <p class="mt-3 text-slate-600"><%= @due_review_count.zero? ? "No reviews due right now." : "Due today: #{@due_review_count}" %></p>
    <div class="mt-6">
      <% if @active_daily_review %>
        <%= link_to "Resume Daily Review", study_session_path(@active_daily_review), class: "inline-flex rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
      <% elsif @due_review_count.positive? %>
        <%= button_to "Start Daily Review", study_sessions_path, params: { session_type: "daily_review" }, method: :post, class: "rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
      <% end %>
    </div>
  </section>
</main>
