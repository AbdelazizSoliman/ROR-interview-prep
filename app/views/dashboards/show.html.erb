<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
  <section>
    <p class="text-sm font-semibold uppercase tracking-widest text-red-700">Dashboard</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Ruby &amp; Rails Interview Prep</h1>
    <p class="mt-3 text-slate-600">Welcome back, <%= current_user.email %>.</p>
  </section>

  <section class="mt-10 grid gap-4 sm:grid-cols-3" aria-label="Study overview">
    <% [["Questions reviewed", 0], ["Mastered", 0], ["Due today", 0]].each do |label, value| %>
      <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm font-medium text-slate-500"><%= label %></p>
        <p class="mt-2 text-3xl font-bold text-slate-950"><%= value %></p>
      </article>
    <% end %>
  </section>
</main>
