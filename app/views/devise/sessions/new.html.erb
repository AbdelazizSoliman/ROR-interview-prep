<main class="mx-auto max-w-md px-4 py-12 sm:px-6">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">Sign in</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-7 space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "rounded border-slate-300 text-red-700 focus:ring-red-600" %>
          <%= f.label :remember_me, class: "text-sm text-slate-700" %>
        </div>
      <% end %>

      <%= f.submit "Sign in", class: "w-full rounded-md bg-red-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-800" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</main>
