<div class="mt-6 space-y-2 text-sm text-slate-600">
  <% if controller_name != "sessions" %>
    <p><%= link_to "Already have an account? Sign in", new_session_path(resource_name), class: "font-medium text-red-700 hover:text-red-800" %></p>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <p><%= link_to "Need an account? Sign up", new_registration_path(resource_name), class: "font-medium text-red-700 hover:text-red-800" %></p>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium text-red-700 hover:text-red-800" %></p>
  <% end %>
</div>
