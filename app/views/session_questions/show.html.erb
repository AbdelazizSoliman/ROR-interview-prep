<main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
    <p class="font-semibold uppercase tracking-widest text-red-700">
      Core · <%= @question.topic.name %> · <%= @question.difficulty.humanize %>
    </p>
    <p class="text-slate-500">Question <%= @session_question.position + 1 %> of <%= @study_session.question_count %></p>
  </div>

  <article class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <% if @question.short_title.present? %>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950"><%= @question.short_title %></h1>
    <% end %>
    <p class="mt-4 whitespace-pre-line text-lg leading-8 text-slate-800"><%= @question.prompt %></p>

    <% if @session_question.answered_at? %>
      <section class="mt-8 border-t border-slate-200 pt-6" aria-labelledby="submitted-answer">
        <h2 id="submitted-answer" class="text-sm font-semibold uppercase tracking-wider text-slate-500">Your submitted answer</h2>
        <p class="mt-3 whitespace-pre-wrap rounded-lg bg-slate-50 p-4 leading-7 text-slate-800"><%= @submitted_answer_attempt.answer_text %></p>
        <p class="mt-3 text-sm text-slate-500">Submitted <%= l(@submitted_answer_attempt.submitted_at, format: :long) %>. Answers cannot be edited.</p>
      </section>
    <% else %>
      <%= form_with model: @answer_attempt, url: study_session_session_question_answer_path(@study_session, @session_question), class: "mt-8 border-t border-slate-200 pt-6" do |form| %>
        <% if @answer_attempt.errors.any? %>
          <div class="mb-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
            <p class="font-semibold">Please correct your answer:</p>
            <ul class="mt-2 list-disc pl-5">
              <% @answer_attempt.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form.label :answer_text, "Answer from memory", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :answer_text, rows: 12, autofocus: true, class: "mt-3 block w-full rounded-lg border border-slate-300 px-4 py-3 leading-7 shadow-sm focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-100", placeholder: "Explain your reasoning clearly..." %>
        <%= form.submit "Save answer and continue", class: "mt-5 rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
      <% end %>
    <% end %>
  </article>
</main>
