<main class="mx-auto flex max-w-6xl items-center px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <section class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-red-700">Prepare with purpose</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl">
      Ruby &amp; Rails Interview Prep
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
      Practice technical interview questions, answer from memory, identify weak areas, and build interview readiness.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <%= link_to "Sign up", new_user_registration_path, class: "rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-red-800" %>
      <%= link_to "Sign in", new_user_session_path, class: "rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-800 hover:bg-slate-100" %>
    </div>
  </section>
</main>
