<main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
    <p class="font-semibold uppercase tracking-widest text-red-700">
      Evaluation · <%= @question.topic.name %> · <%= @question.difficulty.humanize %>
    </p>
    <p class="text-slate-500">Question <%= @session_question.position + 1 %> of <%= @study_session.question_count %></p>
  </div>

  <article class="mt-6 space-y-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <header>
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-700">Recall score</p>
      <% if @evaluation %>
        <div class="mt-2 flex items-baseline gap-3">
          <h1 class="text-4xl font-bold text-slate-950"><%= @evaluation.score %> / 5</h1>
          <span class="text-lg font-medium text-slate-600"><%= Interview::EvaluationScore.label(@evaluation.score) %></span>
        </div>
        <p class="mt-3 text-slate-700"><%= @evaluation.summary %></p>
      <% else %>
        <h1 class="mt-2 text-2xl font-bold text-slate-950">Evaluation unavailable</h1>
        <p class="mt-3 text-slate-600">Your answer is saved. Try the deterministic evaluation again.</p>
        <%= button_to "Try evaluation again", study_session_session_question_evaluation_path(@study_session, @session_question), method: :post, class: "mt-5 rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
      <% end %>
    </header>

    <% if @answer_attempt %>
      <section class="border-t border-slate-200 pt-6" aria-labelledby="your-answer">
        <h2 id="your-answer" class="text-sm font-semibold uppercase tracking-wider text-slate-500">Your answer</h2>
        <p class="mt-3 whitespace-pre-wrap rounded-lg bg-slate-50 p-4 leading-7 text-slate-800"><%= @answer_attempt.answer_text %></p>
      </section>
    <% end %>

    <% if @evaluation %>
      <section class="border-t border-slate-200 pt-6" aria-labelledby="matched-concepts">
        <h2 id="matched-concepts" class="text-lg font-semibold text-slate-950">What you got right</h2>
        <% if @evaluation.matched_concepts.any? %>
          <ul class="mt-4 space-y-4">
            <% @evaluation.matched_concepts.each do |concept| %>
              <li><p class="font-medium text-emerald-800">✓ <%= concept["concept"] %></p><p class="mt-1 text-sm leading-6 text-slate-600"><%= concept["explanation"] %></p></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-slate-600">No concepts matched by the deterministic phrase check.</p>
        <% end %>
      </section>

      <section class="border-t border-slate-200 pt-6" aria-labelledby="missing-concepts">
        <h2 id="missing-concepts" class="text-lg font-semibold text-slate-950">Knowledge gaps</h2>
        <% if @evaluation.missing_concepts.any? %>
          <ul class="mt-4 space-y-4">
            <% @evaluation.missing_concepts.each do |concept| %>
              <li><p class="font-medium text-amber-800">✗ <%= concept["concept"] %></p><p class="mt-1 text-sm leading-6 text-slate-600"><%= concept["explanation"] %></p></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-slate-600">No knowledge gaps were identified.</p>
        <% end %>
      </section>

      <% if @evaluation.misconceptions.any? %>
        <section class="border-t border-slate-200 pt-6" aria-labelledby="misconceptions">
          <h2 id="misconceptions" class="text-lg font-semibold text-slate-950">Misconceptions</h2>
          <ul class="mt-4 space-y-4">
            <% @evaluation.misconceptions.each do |misconception| %>
              <li><p class="font-medium text-slate-900"><%= misconception["statement"] %></p><p class="mt-1 text-sm leading-6 text-slate-600"><%= misconception["explanation"] %></p></li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="border-t border-slate-200 pt-6" aria-labelledby="stronger-answer">
        <h2 id="stronger-answer" class="text-lg font-semibold text-slate-950">Stronger answer</h2>
        <p class="mt-3 whitespace-pre-line leading-7 text-slate-700"><%= @evaluation.stronger_answer %></p>
      </section>

      <%= button_to "Continue", study_session_session_question_continue_path(@study_session, @session_question), method: :post, class: "rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white hover:bg-red-800" %>
    <% end %>
  </article>
</main>
