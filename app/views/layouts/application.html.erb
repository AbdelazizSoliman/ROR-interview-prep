<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ror Interview Prep" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ror Interview Prep">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary navigation">
        <%= link_to "Ruby & Rails Interview Prep", root_path, class: "font-semibold tracking-tight text-slate-950" %>

        <% if user_signed_in? %>
          <div class="flex items-center gap-4 sm:gap-6">
            <%= link_to "Dashboard", dashboard_path, class: "text-sm font-medium text-slate-700 hover:text-slate-950" %>
            <span class="hidden text-sm text-slate-500 sm:inline"><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          </div>
        <% end %>
      </nav>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="mx-auto max-w-6xl px-4 pt-5 sm:px-6 lg:px-8" aria-live="polite">
        <% if notice.present? %>
          <p class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= alert %></p>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
